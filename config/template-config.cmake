@PACKAGE_INIT@

set(DFTD4_WITH_OpenMP @DFTD4_WITH_OpenMP@)
set(DFTD4_WITH_API @DFTD4_WITH_API@)
set(DFTD4_WITH_API_V2 @DFTD4_WITH_API_V2@)
set(DFTD4_WITH_ILP64 @DFTD4_WITH_ILP64@)
set(DFTD4_USE_MCTCLIB @DFTD4_USE_MCTCLIB@)
set(DFTD4_USE_MULTICHARGE @DFTD4_USE_MULTICHARGE@)

if(NOT TARGET dftd4::dftd4)
  include(CMakeFindDependencyMacro)

  # Match the BLAS integer ABI used when dftd4 was built.
  if(DEFINED BLA_SIZEOF_INTEGER)
    set(_dftd4_saved_bla_sizeof_integer "${BLA_SIZEOF_INTEGER}")
  endif()
  if(DFTD4_WITH_ILP64)
    set(BLA_SIZEOF_INTEGER 8)
  else()
    set(BLA_SIZEOF_INTEGER 4)
  endif()

  if(DFTD4_USE_MCTCLIB AND NOT TARGET mctc-lib::mctc-lib)
    find_dependency(mctc-lib CONFIG)
  endif()
  if(DFTD4_USE_MULTICHARGE AND NOT TARGET multicharge::multicharge)
    find_dependency(multicharge CONFIG)
  endif()

  if(NOT @BUILD_SHARED_LIBS@)
    if(NOT CMAKE_Fortran_COMPILER_LOADED)
      enable_language(Fortran)
    endif()
    if(DFTD4_WITH_OpenMP AND NOT TARGET OpenMP::OpenMP_Fortran)
      find_dependency(OpenMP COMPONENTS Fortran)
    endif()
    if(NOT TARGET BLAS::BLAS)
      find_dependency(BLAS)
    endif()
    if(NOT TARGET LAPACK::LAPACK)
      find_dependency(LAPACK)
    endif()
  endif()

  include("${CMAKE_CURRENT_LIST_DIR}/dftd4-targets.cmake")

  if(DEFINED _dftd4_saved_bla_sizeof_integer)
    set(BLA_SIZEOF_INTEGER "${_dftd4_saved_bla_sizeof_integer}")
    unset(_dftd4_saved_bla_sizeof_integer)
  else()
    unset(BLA_SIZEOF_INTEGER)
  endif()
endif()

if(COMMAND check_required_components)
  check_required_components(dftd4)
endif()
